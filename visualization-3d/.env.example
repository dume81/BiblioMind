# Neo4j 연결 정보 — 서버 전용 환경 변수.
# 실제 값은 .env.local(로컬) 또는 Vercel 프로젝트 환경 변수(배포)에만 넣는다.
# 어떤 비밀값에도 VITE_ 접두사를 쓰지 않는다 (VITE_* 는 클라이언트 번들에 노출됨).

# "true"일 때만 Neo4j 데이터 소스가 활성화된다. production 기본값은 비활성화.
NEO4J_SOURCE_ENABLED=false

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=readonly-account-name
NEO4J_PASSWORD=replace-with-real-password
NEO4J_DATABASE=neo4j
